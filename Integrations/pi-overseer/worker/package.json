{
  "name": "pi-overseer-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable pi agent (Cloudflare Durable Object) that manages RepoPrompt CE from a phone",
  "scripts": {
    "dev": "npm --prefix ../web run build && wrangler dev",
    "build": "npm --prefix ../web ci && npm --prefix ../web run build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:recovery": "node test/verify-recovery.mjs",
    "build:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
