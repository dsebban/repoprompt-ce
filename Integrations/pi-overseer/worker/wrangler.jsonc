{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-overseer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // pi-ai imports a few Node built-ins (env-based API key lookup); nodejs_compat covers them.
  "compatibility_flags": ["nodejs_compat"],
  // The Svelte phone app. Build it first: `npm run build` (runs the web build).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bridge", "/phone"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PI_OVERSEER", "class_name": "PiOverseer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiOverseer"] }],
  "vars": {
    "PI_PROVIDER": "anthropic",
    "PI_MODEL": "claude-sonnet-4-6",
    "PI_THINKING": "low"
  }
  // Secrets (wrangler secret put …): BRIDGE_TOKEN, PHONE_TOKEN, ANTHROPIC_API_KEY,
  // optional NTFY_URL (e.g. https://ntfy.sh/<long-random-topic>) and NTFY_TOKEN.
}
